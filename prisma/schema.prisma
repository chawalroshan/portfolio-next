// Prisma schema for the portfolio.
// Provider: PostgreSQL (Vercel Postgres / Neon).
// String[] scalar lists (techStack, tags) are natively supported on Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  techStack   String[]
  imageUrl    String?
  liveUrl     String?
  repoUrl     String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String // HTML produced by the Tiptap editor
  excerpt     String? // short summary for cards / meta description
  coverImage  String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String // e.g. "Frontend", "Backend", "Database", "DevOps"
  icon      String // registry key resolved in src/lib/icons.tsx (e.g. "react")
  level     String   @default("Intermediate")
  url       String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
}

// Singleton row (id is fixed to "profile"). socialLinks stored as JSON:
// [{ "label": "GitHub", "url": "https://...", "icon": "github" }, ...]
model Profile {
  id          String   @id @default("profile")
  name        String
  title       String
  bio         String
  bioSecondary String?
  resumeUrl   String?
  email       String?
  socialLinks Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Admin user for NextAuth Credentials login.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
